{
  "name": "cat-agent-skills",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "A gallery of skills for Cowork, Copilot Studio, and Scout AI agents.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "validate:skills": "node --import tsx scripts/validate-skill.ts src/content/skills/*.md",
    "import:submissions": "node --import tsx scripts/import-submissions.ts",
    "check:submissions": "node --import tsx scripts/import-submissions.ts --check",
    "sync:upstream": "node scripts/sync-upstream-submissions.mjs",
    "check:upstream-rendered-content": "node scripts/verify-rendered-markdown.mjs",
    "check:upstream-sync-scope": "node scripts/sync-upstream-submissions.mjs --verify-worktree",
    "test": "node --import tsx --test scripts/*.test.ts",
    "engagement:fetch": "node --import tsx scripts/fetch-engagement.ts",
    "ratings:fetch": "node --import tsx scripts/fetch-engagement.ts",
    "artwork:pending": "node --import tsx scripts/skill-artwork.ts pending",
    "artwork:prepare": "node --import tsx scripts/skill-artwork.ts prepare",
    "artwork:validate": "node --import tsx scripts/skill-artwork.ts validate"
  },
  "dependencies": {
    "astro": "^7.1.0",
    "giscus": "^1.6.0"
  },
  "devDependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.4",
    "@types/adm-zip": "^0.5.8",
    "adm-zip": "^0.6.0",
    "croner": "^9.1.0",
    "gray-matter": "^4.0.3",
    "hast-util-from-html": "^2.0.3",
    "js-yaml": "^4.3.2",
    "satori": "^0.26.0",
    "satteri": "^0.9.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.22.4"
  }
}
