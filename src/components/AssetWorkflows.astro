---
import type { LibraryAsset, LibraryAssetSummary } from "../lib/library-assets";
import { withBase } from "../lib/url";
import { assetId } from "./asset-detail-data";

interface Props {
  asset: LibraryAsset;
  allAssets: readonly LibraryAssetSummary[];
}

const { asset, allAssets } = Astro.props;
const byId = new Map(allAssets.map((candidate) => [assetId(candidate), candidate]));
const workflows = asset.series.map((membership) => ({
  ...membership,
  previous: membership.previousAssetId ? byId.get(membership.previousAssetId) : undefined,
  next: membership.nextAssetId ? byId.get(membership.nextAssetId) : undefined,
}));
---

<section class="mt-10 rounded-lg border border-[var(--border-subtle)] bg-surface-2 p-5" aria-labelledby="workflow-membership-heading">
  <span class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-text">Connected Work</span>
  <h2 id="workflow-membership-heading" class="mt-1 text-xl text-[var(--text-heading)]">Workflow Membership</h2>
  <div class="mt-4 space-y-4">
    {workflows.map((workflow) => (
      <article class="rounded border border-border bg-surface p-4">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="text-base font-semibold text-fg">{workflow.title}</h3>
          <span class="text-xs font-medium text-muted">Step {workflow.step} of {workflow.totalSteps}</span>
        </div>
        <nav class="mt-3 grid gap-2 sm:grid-cols-2" aria-label={`${workflow.title} workflow`}>
          {workflow.previous ? (
            <a href={withBase(workflow.previous.canonicalPath)} class="rounded border border-border px-3 py-2 text-sm no-underline hover:border-accent/50">
              <span class="block text-[10px] font-semibold uppercase tracking-[0.08em] text-subtle">Previous</span>
              <span class="mt-0.5 block font-medium text-[var(--link)]">← {workflow.previous.name}</span>
            </a>
          ) : (
            <span class="rounded border border-dashed border-border px-3 py-2 text-sm text-subtle">
              {workflow.previousAssetId ? "The previous step is not published." : "This asset starts the workflow."}
            </span>
          )}
          {workflow.next ? (
            <a href={withBase(workflow.next.canonicalPath)} class="rounded border border-border px-3 py-2 text-right text-sm no-underline hover:border-accent/50">
              <span class="block text-[10px] font-semibold uppercase tracking-[0.08em] text-subtle">Next</span>
              <span class="mt-0.5 block font-medium text-[var(--link)]">{workflow.next.name} →</span>
            </a>
          ) : (
            <span class="rounded border border-dashed border-border px-3 py-2 text-right text-sm text-subtle">
              {workflow.nextAssetId ? "The next step is not published." : "This asset completes the workflow."}
            </span>
          )}
        </nav>
      </article>
    ))}
  </div>
</section>
