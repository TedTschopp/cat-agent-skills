---
import Layout from "../layouts/Layout.astro";
import type { LibraryAsset, LibraryAssetSummary } from "../lib/library-assets";
import { authorKey } from "../lib/badges";
import { coverGradient, initials } from "../lib/skills";
import { SITE_METADATA, toIsoDate } from "../lib/site-metadata";
import { withBase } from "../lib/url";
import AssetCard from "./AssetCard.astro";
import AssetDownloads from "./AssetDownloads.astro";
import AssetEngagement from "./AssetEngagement.astro";
import AssetWorkflows from "./AssetWorkflows.astro";
import SkillCover from "./SkillCover.astro";
import { ANALYTICS_ENABLED } from "../lib/analytics-config";
import { worksWithLabel } from "./asset-labels";
import { topicKey } from "./topic-routing";

interface Props {
  asset: LibraryAsset;
  relatedAssets?: LibraryAssetSummary[];
  allAssets?: readonly LibraryAssetSummary[];
}

const { asset, relatedAssets = [], allAssets = [] } = Astro.props;
const isSample = asset.tags.includes("sample");
const authorSlug = authorKey(asset.author.github ?? undefined, asset.author.name);
const authorProfileUrl = asset.author.url ?? (asset.author.github ? `https://github.com/${asset.author.github}` : null);
const socialNamespace = ["skill", "plugin", "automation"].includes(asset.kind)
  ? "skills"
  : asset.kind === "prompt-template"
    ? "prompts"
    : "library";
const socialImagePath = `/social/${socialNamespace}/${asset.slug}.jpg`;
const socialImageUrl = new URL(socialImagePath, SITE_METADATA.url).href;
const canonicalUrl = new URL(asset.canonicalPath, SITE_METADATA.url).href;
const socialImageAlt = asset.artwork.alt
  ? `Social preview for ${asset.name}. ${asset.artwork.alt}`
  : `Branded AI.Tedt.org preview for ${asset.name}, a ${asset.kindLabel.toLocaleLowerCase()} by ${asset.author.name}.`;
const publishedIso = toIsoDate(asset.dates.created ?? undefined);
const modifiedIso = toIsoDate(asset.dates.updated ?? asset.dates.created ?? undefined);
const statusTone = asset.status === "beta" ? "var(--status-beta)" : "var(--status-active)";

const assetSchema = {
  "@type": "CreativeWork",
  "@id": `${canonicalUrl}#asset`,
  name: asset.name,
  description: asset.description,
  url: canonicalUrl,
  mainEntityOfPage: { "@id": `${canonicalUrl}#webpage` },
  isPartOf: { "@id": `${SITE_METADATA.url}#website` },
  image: socialImageUrl,
  author: {
    "@type": "Person",
    name: asset.author.name,
    ...(authorProfileUrl ? { url: authorProfileUrl } : {}),
  },
  publisher: { "@id": `${SITE_METADATA.url}#owner` },
  ...(publishedIso ? { dateCreated: publishedIso } : {}),
  ...(modifiedIso ? { dateModified: modifiedIso } : {}),
  ...(asset.version ? { version: asset.version } : {}),
  keywords: [...new Set([...asset.topics, ...asset.tags, ...asset.keywords])],
  genre: asset.kindLabel,
  learningResourceType: asset.kindLabel,
  isAccessibleForFree: true,
  about: asset.worksWith.map((item) => ({ "@type": "Thing", name: worksWithLabel(item) })),
};
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "AI Library", item: SITE_METADATA.url },
    { "@type": "ListItem", position: 2, name: asset.name, item: canonicalUrl },
  ],
};
---

<Layout
  title={asset.name}
  description={asset.description}
  canonicalPath={isSample ? false : asset.canonicalPath}
  image={{ path: socialImagePath, alt: socialImageAlt, width: 1200, height: 630, type: "image/jpeg" }}
  ogType="article"
  schemaType="ItemPage"
  noindex={isSample}
  publishedTime={asset.dates.created ?? undefined}
  modifiedTime={asset.dates.updated ?? asset.dates.created ?? undefined}
  authorName={asset.author.name}
  authorUrl={authorProfileUrl ?? undefined}
  section={asset.kindLabel}
  tags={[...new Set([...asset.topics, ...asset.tags])]}
  structuredData={[assetSchema, breadcrumbSchema]}
  fediverseCreator={false}
>
  <div class="mx-auto max-w-[82.5rem] px-4 py-8 sm:px-6 sm:py-10">
    <a href={withBase("/")} class="inline-flex items-center gap-1.5 text-sm text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]">
      <span aria-hidden="true">←</span>
      All Assets
    </a>

    <header class="mt-6">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex rounded-sm bg-accent-soft px-2 py-0.5 text-xs font-semibold uppercase tracking-[0.08em] text-accent-text">
          {asset.kindLabel}
        </span>
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.08em] text-muted">
          <span class="h-2 w-2 rounded-full" style={`background:${statusTone};`} aria-hidden="true"></span>
          {asset.status}
        </span>
      </div>
      <h1 class="mt-3 max-w-[22ch] text-4xl leading-tight text-[var(--text-heading)] sm:text-5xl">
        {asset.name}
      </h1>
      <p class="mt-3 max-w-[68ch] text-lg leading-relaxed text-muted sm:text-xl">
        {asset.description}
      </p>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-subtle">
        {asset.dates.updated && (
          <span><span class="text-xs font-semibold uppercase tracking-[0.08em]">Updated</span> {new Date(asset.dates.updated).toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}</span>
        )}
        {asset.version && <><span aria-hidden="true">·</span><span><span class="text-xs font-semibold uppercase tracking-[0.08em]">Version</span> {asset.version}</span></>}
        {asset.downloads > 0 && <><span aria-hidden="true">·</span><span>{asset.downloads.toLocaleString("en-US")} {asset.downloads === 1 ? "download" : "downloads"}</span></>}
      </div>
      <div class="accent-rule mt-5"></div>
    </header>

    {isSample && (
      <div class="mt-5 rounded-lg border border-[var(--gold)] bg-[color-mix(in_srgb,var(--gold)_12%,transparent)] p-4">
        <p class="text-sm text-fg/80"><span class="font-semibold text-fg">Sample Asset.</span> This is demonstration content, not a production-ready submission.</p>
      </div>
    )}

    <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-12">
      <div class="order-last min-w-0 lg:order-none">
        <div class="flex items-center gap-3">
          <a
            href={authorProfileUrl ?? withBase(`/?contributor=${encodeURIComponent(authorSlug)}`)}
            target={authorProfileUrl ? "_blank" : undefined}
            rel={authorProfileUrl ? "noopener noreferrer" : undefined}
            class="shrink-0"
            aria-label={authorProfileUrl ? `Open ${asset.author.name}'s profile` : `Browse assets by ${asset.author.name}`}
          >
            <span class="relative grid h-10 w-10 place-items-center overflow-hidden rounded-full text-[11px] font-bold text-white ring-1 ring-border" style={`background-image:${coverGradient(asset.author.name)}`}>
              {initials(asset.author.name)}
              {(asset.author.avatar || asset.author.github) && (
                <img
                  src={asset.author.avatar ?? `https://github.com/${asset.author.github}.png?size=80`}
                  alt=""
                  loading="lazy"
                  onerror="this.remove()"
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}
            </span>
          </a>
          <div class="min-w-0 leading-snug">
            <div class="truncate text-sm">
              <span class="text-muted">by </span>
              {authorProfileUrl ? (
                <a href={authorProfileUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-fg hover:text-accent-text">{asset.author.name}</a>
              ) : (
                <span class="font-semibold text-fg">{asset.author.name}</span>
              )}
            </div>
            <a href={withBase(`/?contributor=${encodeURIComponent(authorSlug)}`)} class="mt-0.5 inline-flex text-xs font-medium text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]">
              View Contributor’s Assets
            </a>
          </div>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-2">
          <a href="#rate" class="inline-flex items-center rounded-full border border-border bg-surface-2 px-3 py-1 text-sm font-medium text-fg no-underline hover:border-accent/50">
            <span aria-hidden="true">▲</span><span class="ml-1.5">{asset.rating}</span><span class="ml-1 text-muted">{asset.rating === 1 ? "rating" : "ratings"}</span>
            <span class="mx-2 h-4 w-px bg-border" aria-hidden="true"></span><span class="text-accent-text">Rate and Discuss</span>
          </a>
        </div>

        {asset.topics.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
            {asset.topics.map((topic) => (
              <a href={withBase(`/?topic=${encodeURIComponent(topicKey(topic))}`)} class="rounded-full border border-border bg-surface-2 px-3 py-1 text-sm text-muted no-underline hover:border-accent/50 hover:text-fg">{topic}</a>
            ))}
          </div>
        )}

        <div class="mt-8 space-y-8">
          <slot name="workbench" />
          <slot />
        </div>

        {asset.series.length > 0 && <AssetWorkflows {asset} {allAssets} />}
      </div>

      <aside class="order-first lg:order-none lg:sticky lg:top-4 lg:self-start">
        <div class="overflow-hidden rounded-lg border border-[var(--border-subtle)] bg-surface shadow-[var(--shadow-sm)]">
          <SkillCover
            slug={asset.slug}
            name={asset.name}
            coverImage={asset.artwork.image ?? undefined}
            coverImageAlt={asset.artwork.alt ?? undefined}
            coverImageWidth={asset.artwork.width ?? undefined}
            coverImageHeight={asset.artwork.height ?? undefined}
          />
          <AssetDownloads {asset} />
        </div>
      </aside>
    </div>

    {relatedAssets.length > 0 && (
      <section class="mt-12 border-t border-border pt-8" aria-labelledby="related-assets-heading">
        <div class="mb-5 flex flex-wrap items-baseline justify-between gap-3">
          <div>
            <span class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-text">Continue Exploring</span>
            <h2 id="related-assets-heading" class="mt-1 text-2xl text-[var(--text-heading)]">Related Assets</h2>
          </div>
          <a href={withBase("/")} class="text-sm text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]">Browse the Full Library</a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {relatedAssets.slice(0, 3).map((related) => <AssetCard asset={related} />)}
        </div>
      </section>
    )}

    <AssetEngagement {asset} />
  </div>

  {
    ANALYTICS_ENABLED && (
      <script
        is:inline
        set:html={`(function(){function fire(){if(typeof window.clarity!=="function"){return setTimeout(fire,300);}window.clarity("set","asset",${JSON.stringify(
          asset.slug,
        )});window.clarity("set","assetKind",${JSON.stringify(
          asset.kind,
        )});window.clarity("event","asset_view");${
          ["skill", "plugin", "automation"].includes(asset.kind)
            ? `window.clarity("set","skill",${JSON.stringify(asset.slug)});window.clarity("set","skillType",${JSON.stringify(asset.kind)});window.clarity("event","skill_view");`
            : ""
        }}fire();})();`}
      />
    )
  }
</Layout>
