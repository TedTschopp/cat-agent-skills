---
import { withBase } from "../lib/url";
import SkillCover from "./SkillCover.astro";
import type { Platform, SkillType } from "../lib/skills";

interface Props {
  slug: string;
  name: string;
  description: string;
  platforms?: Platform[];
  type?: SkillType;
  tags?: string[];
  author?: string;
  coverColor?: string;
  coverImage?: string;
  coverImageAlt?: string;
  coverImageWidth?: number;
  coverImageHeight?: number;
  hasBundle?: boolean;
  isInstaller?: boolean;
  rating?: number;
  downloads?: number;
  featured?: boolean;
}

const {
  slug,
  name,
  description,
  platforms = [],
  type = "skill",
  tags = [],
  author,
  coverColor,
  coverImage,
  coverImageAlt,
  coverImageWidth,
  coverImageHeight,
  hasBundle = false,
  isInstaller = false,
  rating = 0,
  downloads = 0,
  featured = false,
} = Astro.props;

const isSample = tags.includes("sample");
const shownTags = tags.filter((tag) => tag !== "sample").slice(0, 4);
const isInteractive = !isSample;
const payload = hasBundle
  ? type === "automation" && !isInstaller
    ? ".json"
    : ".zip"
  : ".md";
const platformTone: Record<Platform, string> = {
  Cowork: "var(--platform-cowork)",
  "Copilot Studio": "var(--platform-copilot-studio)",
  Scout: "var(--platform-scout)",
};
const Wrapper = isInteractive ? "a" : "div";
const wrapperProps = isInteractive
  ? { href: withBase(`/skills/${slug}/`) }
  : {
      "aria-disabled": "true",
      title: "Sample content — not a production-ready submission",
    };
---

<Wrapper
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-lg border bg-surface text-fg no-underline shadow-[var(--shadow-sm)]",
    isInteractive &&
      "transition hover:-translate-y-0.5 hover:border-[var(--border-strong)] hover:shadow-[var(--shadow)]",
    isSample && "cursor-not-allowed select-none opacity-55 saturate-50",
  ]}
  style={featured ? "border-color:var(--orange);" : "border-color:var(--border-subtle);"}
  {...wrapperProps}
>
  <SkillCover
    slug={slug}
    name={name}
    coverColor={coverColor}
    coverImage={coverImage}
    coverImageAlt={coverImageAlt}
    coverImageWidth={coverImageWidth}
    coverImageHeight={coverImageHeight}
  />

  <div class="flex flex-1 flex-col gap-2 p-4">
    <div class="flex flex-wrap items-center gap-2">
      {
        platforms.map((platform) => (
          <span
            class="rounded-sm border px-2 py-0.5 text-xs font-medium leading-snug"
            style={`color:${platformTone[platform]};border-color:${platformTone[platform]};`}
          >
            {platform}
          </span>
        ))
      }
      {
        type !== "skill" && (
          <span class="text-[10px] font-semibold uppercase tracking-[0.08em] text-subtle">
            {type}
          </span>
        )
      }
      {
        featured && (
          <span class="inline-flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-muted">
            <span class="h-2 w-2 rounded-full bg-[var(--orange)]"></span>
            Featured
          </span>
        )
      }
      {
        isSample && (
          <span class="inline-flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-[0.08em] text-muted">
            <span class="h-2 w-2 rounded-full bg-[var(--gold)]"></span>
            Sample
          </span>
        )
      }
    </div>

    <h3
      class="display-face line-clamp-2 text-xl leading-snug text-[var(--text-heading)] group-hover:text-[var(--accent-signal-text)]"
      title={name}
    >
      {name}
    </h3>

    <p class="line-clamp-3 flex-1 text-sm leading-relaxed text-muted">
      {description}
    </p>

    {
      shownTags.length > 0 && (
        <div class="mt-auto flex flex-wrap gap-1 pt-2">
          {shownTags.map((tag) => (
            <span class="rounded-full border border-border bg-surface-2 px-2 py-0.5 text-[11px] font-medium text-muted">
              {tag}
            </span>
          ))}
        </div>
      )
    }

    <div class="mt-1 flex items-center justify-between gap-3 border-t border-[var(--border-subtle)] pt-2 text-xs text-subtle">
      <span class="min-w-0 truncate">{author ?? "Community contributor"}</span>
      <span class="flex shrink-0 items-center gap-3 tabular-nums">
        <span class="mono-face text-[var(--accent-signal-text)]">{payload}</span>
        {rating > 0 && <span title={`${rating} ${rating === 1 ? "rating" : "ratings"}`}>▲ {rating}</span>}
        {
          downloads > 0 && (
            <span title={`${downloads.toLocaleString("en-US")} ${downloads === 1 ? "download" : "downloads"}`}>
              ↓ {downloads.toLocaleString("en-US")}
            </span>
          )
        }
      </span>
    </div>
  </div>
</Wrapper>
