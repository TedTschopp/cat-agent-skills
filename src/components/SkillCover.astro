---
import {
  coverAccent,
  coverField,
  initials,
  type Platform,
  type SkillType,
} from "../lib/skills";
import { withBase } from "../lib/url";

interface Props {
  slug: string;
  name: string;
  platforms?: Platform[];
  type?: SkillType;
  tags?: string[];
  coverColor?: string;
  coverImage?: string;
  coverImageAlt?: string;
  coverImageWidth?: number;
  coverImageHeight?: number;
  hasBundle?: boolean;
  isInstaller?: boolean;
  variant?: "card" | "hero";
  class?: string;
}

const {
  slug,
  name,
  coverColor,
  coverImage,
  coverImageAlt,
  coverImageWidth = 1600,
  coverImageHeight = 1000,
  variant = "card",
  class: className = "",
} = Astro.props;

const field = coverField(slug, coverColor);
const accent = coverColor ?? coverAccent(slug);
const mark = initials(name);
const isHero = variant === "hero";
const imageUrl = coverImage ? withBase(coverImage) : undefined;
---

<div
  class:list={[
    "relative grid aspect-[16/10] w-full place-items-center overflow-hidden bg-[var(--slate)]",
    className,
  ]}
  style={`background:${field};`}
>
  {
    imageUrl ? (
      <img
        src={imageUrl}
        alt={coverImageAlt ?? ""}
        width={coverImageWidth}
        height={coverImageHeight}
        loading={isHero ? "eager" : "lazy"}
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover"
      />
    ) : (
      <span
        class:list={[
          "display-face select-none leading-none tracking-[-0.01em] text-[var(--paper)]",
          isHero ? "text-7xl sm:text-8xl" : "text-6xl",
        ]}
        style={`text-shadow:0 0 1.4rem ${accent},0 1px 0 rgba(0,0,0,.6);`}
        aria-hidden="true"
      >
        {mark}
      </span>
    )
  }
  <span
    class="absolute inset-x-0 bottom-0 h-[3px]"
    style={`background:${accent};`}
    aria-hidden="true"
  ></span>
</div>
