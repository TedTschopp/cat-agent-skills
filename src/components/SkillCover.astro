---
import {
  coverAccent,
  coverField,
  initials,
  type Platform,
  type SkillType,
} from "../lib/skills";

interface Props {
  slug: string;
  name: string;
  platforms?: Platform[];
  type?: SkillType;
  tags?: string[];
  coverColor?: string;
  hasBundle?: boolean;
  isInstaller?: boolean;
  variant?: "card" | "hero";
  class?: string;
}

const {
  slug,
  name,
  coverColor,
  variant = "card",
  class: className = "",
} = Astro.props;

const field = coverField(slug, coverColor);
const accent = coverColor ?? coverAccent(slug);
const mark = initials(name);
const isHero = variant === "hero";
---

<div
  class:list={[
    "relative grid place-items-center overflow-hidden bg-[var(--slate)]",
    isHero ? "h-40 sm:h-44" : "h-[8.25rem]",
    className,
  ]}
  style={`background:${field};`}
  aria-hidden="true"
>
  <span
    class:list={[
      "display-face select-none leading-none tracking-[-0.01em] text-[var(--paper)]",
      isHero ? "text-7xl sm:text-8xl" : "text-6xl",
    ]}
    style={`text-shadow:0 0 1.4rem ${accent},0 1px 0 rgba(0,0,0,.6);`}
  >
    {mark}
  </span>
  <span
    class="absolute inset-x-0 bottom-0 h-[3px]"
    style={`background:${accent};`}
  ></span>
</div>
