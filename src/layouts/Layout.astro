---
import "../styles/global.css";
import { withBase } from "../lib/url";
import { FEEDBACK_URL } from "../lib/issues";
import { ANALYTICS_ENABLED, CLARITY_PROJECT_ID } from "../lib/analytics-config";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Prompts and Agent Skills",
  description = "Reusable prompts, agent skills, plugins, and automations for Cowork, Copilot Studio, and Scout.",
} = Astro.props;

const fullTitle = `${title} · AI.Tedt.org`;
const path = Astro.url.pathname;
const contributorsActive = path.includes("/authors");
---

<!doctype html>
<html lang="en" data-default-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="msvalidate.01" content="486EC2936921901A59F27BD421FB062D" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="apple-touch-icon" sizes="196x196" href={withBase("/favicon-196.png")} />
    {/* Resolve the saved preference before paint to prevent a theme flash. */}
    <script
      is:inline
      set:html={`(function(){try{var d=document.documentElement;var key='ai-tedt-theme';var p=localStorage.getItem(key)||d.dataset.defaultTheme||'system';var dark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;var resolved=p==='system'?(dark?'dark':'light'):p;d.dataset.themePreference=p;d.setAttribute('data-theme',resolved);}catch(e){document.documentElement.dataset.themePreference='system';document.documentElement.setAttribute('data-theme','light');}})();`}
    />
    {
      ANALYTICS_ENABLED && (
        <script
          is:inline
          type="text/javascript"
          set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${CLARITY_PROJECT_ID}");`}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only z-50 rounded bg-accent px-3 py-2 text-sm font-semibold text-accent-fg focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
    >
      Skip to content
    </a>

    <header class="border-b border-border bg-bg">
      <div
        class="mx-auto flex max-w-8xl flex-wrap items-center gap-x-5 gap-y-3 px-4 py-4 sm:px-6"
      >
        <a
          href={withBase("/")}
          class="flex shrink-0 items-center gap-3 no-underline"
          aria-label="AI.Tedt.org — Prompts and Agent Skills"
        >
          <img
            src={withBase("/logo-site.webp")}
            alt=""
            width="38"
            height="38"
            class="h-[38px] w-[38px] rounded-sm object-cover"
          />
          <span class="flex flex-col leading-none">
            <span class="display-face text-xl text-fg">AI.Tedt.org</span>
            <span class="mt-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-accent-text sm:text-xs">
              Prompts and Agent Skills
            </span>
          </span>
        </a>

        <nav class="flex w-full flex-wrap items-center justify-between gap-3 text-sm sm:ml-auto sm:w-auto sm:justify-end sm:gap-4">
          <a
            href={FEEDBACK_URL}
            target="_blank"
            rel="noopener"
            data-clarity-event="report_issue"
            data-clarity-report-scope="site"
            class="hidden border-b-[3px] border-transparent pb-0.5 text-muted no-underline hover:border-accent-text hover:text-fg md:inline-flex"
          >
            Report an issue
          </a>
          <a
            href={withBase("/authors")}
            class:list={[
              "hidden border-b-[3px] pb-0.5 no-underline md:inline-flex",
              contributorsActive
                ? "border-accent-text text-fg"
                : "border-transparent text-muted hover:border-accent-text hover:text-fg",
            ]}
          >
            Contributors
          </a>
          <a
            href="https://github.com/microsoft/cat-agent-skills/blob/main/CONTRIBUTING.md"
            target="_blank"
            rel="noopener"
            class="rounded bg-cta px-3 py-1.5 font-semibold text-cta-fg no-underline shadow-sm hover:bg-[var(--action-cta-hover)]"
          >
            <span class="sm:hidden">Contribute</span>
            <span class="hidden sm:inline">Contribute a skill</span>
          </a>
          <div
            id="theme-toggle"
            role="radiogroup"
            aria-label="Colour theme"
            class="inline-flex overflow-hidden rounded-full border border-border bg-surface-2 p-0.5"
          >
            {
              ["Light", "System", "Dark"].map((label) => (
                <button
                  type="button"
                  role="radio"
                  aria-checked="false"
                  data-theme-choice={label.toLowerCase()}
                  class="rounded-full px-2 py-1 text-[11px] font-medium text-muted hover:text-fg sm:px-2.5"
                >
                  {label}
                </button>
              ))
            }
          </div>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-bg">
      <div
        class="mx-auto flex max-w-8xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p>
          A practitioner-built library for Cowork, Copilot Studio, and Scout agents.
        </p>
        <a
          href="https://github.com/microsoft/cat-agent-skills"
          target="_blank"
          rel="noopener"
          class="text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]"
        >
          View the upstream repository
        </a>
      </div>
    </footer>

    <script
      is:inline
      set:html={`(function(){var d=document.documentElement;var key='ai-tedt-theme';var buttons=Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));var mq=window.matchMedia?window.matchMedia('(prefers-color-scheme: dark)'):null;function resolved(p){return p==='system'?((mq&&mq.matches)?'dark':'light'):p;}function paint(){var p=d.dataset.themePreference||'system';buttons.forEach(function(b){var on=b.dataset.themeChoice===p;b.setAttribute('aria-checked',String(on));b.classList.toggle('bg-accent',on);b.classList.toggle('text-accent-fg',on);b.classList.toggle('text-muted',!on);});}function setPreference(p,save){d.dataset.themePreference=p;d.setAttribute('data-theme',resolved(p));if(save){try{localStorage.setItem(key,p);}catch(e){}}paint();document.dispatchEvent(new CustomEvent('themechange',{detail:{theme:d.getAttribute('data-theme'),preference:p}}));}buttons.forEach(function(b){b.addEventListener('click',function(){setPreference(b.dataset.themeChoice||'system',true);});});if(mq){var onSystem=function(){if((d.dataset.themePreference||'system')==='system')setPreference('system',false);};if(mq.addEventListener)mq.addEventListener('change',onSystem);else if(mq.addListener)mq.addListener(onSystem);}paint();})();`}
    />
    {
      ANALYTICS_ENABLED && (
        <script
          is:inline
          set:html={`document.addEventListener("click",function(e){var el=e.target&&e.target.closest?e.target.closest("[data-clarity-event]"):null;if(!el)return;if(typeof window.clarity!=="function")return;var name=el.getAttribute("data-clarity-event");if(!name)return;for(var i=0;i<el.attributes.length;i++){var a=el.attributes[i];if(a.name.indexOf("data-clarity-")===0&&a.name!=="data-clarity-event"){var key=a.name.slice("data-clarity-".length).replace(/-([a-z])/g,function(m,c){return c.toUpperCase();});window.clarity("set",key,a.value);}}window.clarity("event",name);},true);`}
        />
      )
    }
  </body>
</html>
