---
import "../styles/global.css";
import UniversalHeader from "../components/UniversalHeader.astro";
import { withBase } from "../lib/url";
import { FEEDBACK_URL } from "../lib/issues";
import { ANALYTICS_ENABLED, CLARITY_PROJECT_ID } from "../lib/analytics-config";
import {
  SITE_METADATA,
  compactDescription,
  toIsoDate,
  type OpenGraphType,
  type PageSchemaType,
  type SocialImageMetadata,
} from "../lib/site-metadata";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string | false;
  image?: SocialImageMetadata;
  ogType?: OpenGraphType;
  schemaType?: PageSchemaType;
  noindex?: boolean;
  publishedTime?: Date | string;
  modifiedTime?: Date | string;
  authorName?: string;
  authorUrl?: string;
  section?: string;
  tags?: string[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  fediverseCreator?: string | false;
}

const {
  title = SITE_METADATA.title,
  description = SITE_METADATA.description,
  canonicalPath,
  image = {
    path: SITE_METADATA.socialImagePath,
    alt: SITE_METADATA.socialImageAlt,
    width: SITE_METADATA.socialImageWidth,
    height: SITE_METADATA.socialImageHeight,
    type: SITE_METADATA.socialImageType,
  },
  ogType = "website",
  schemaType = "WebPage",
  noindex = false,
  publishedTime,
  modifiedTime,
  authorName = SITE_METADATA.owner,
  authorUrl,
  section,
  tags = [],
  structuredData = [],
  fediverseCreator = SITE_METADATA.fediverseCreator,
} = Astro.props;

const fullTitle = `${title} · ${SITE_METADATA.name}`;
const metaDescription = compactDescription(description, 200);
const siteUrl = Astro.site ?? new URL(SITE_METADATA.url);
const pageUrl = new URL(Astro.url.pathname, siteUrl);
const canonicalUrl =
  canonicalPath === false
    ? undefined
    : new URL(canonicalPath ?? Astro.url.pathname, siteUrl);
const siteRoot = new URL(withBase("/"), siteUrl);
const imagePath = /^https?:\/\//i.test(image.path)
  ? image.path
  : withBase(image.path);
const imageUrl = new URL(imagePath, siteUrl);
const imageWidth = image.width ?? SITE_METADATA.socialImageWidth;
const imageHeight = image.height ?? SITE_METADATA.socialImageHeight;
const imageType = image.type ?? SITE_METADATA.socialImageType;
const publishedIso = toIsoDate(publishedTime);
const modifiedIso = toIsoDate(modifiedTime);
const robots = noindex
  ? "noindex, follow, max-image-preview:large"
  : "max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const ownerId = `${siteRoot.href}#owner`;
const websiteId = `${siteRoot.href}#website`;
const pageId = canonicalUrl ? `${canonicalUrl.href}#webpage` : undefined;
const imageId = `${imageUrl.href}#primaryimage`;
const author =
  authorName === SITE_METADATA.owner
    ? { "@id": ownerId }
    : {
        "@type": "Person",
        name: authorName,
        ...(authorUrl ? { url: authorUrl } : {}),
      };
const extraStructuredData = Array.isArray(structuredData)
  ? structuredData
  : [structuredData];
const jsonLd =
  canonicalUrl && !noindex
    ? {
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "Person",
            "@id": ownerId,
            name: SITE_METADATA.owner,
            url: SITE_METADATA.ownerUrl,
            sameAs: SITE_METADATA.sameAs,
          },
          {
            "@type": "WebSite",
            "@id": websiteId,
            url: siteRoot.href,
            name: SITE_METADATA.name,
            alternateName: SITE_METADATA.title,
            description: SITE_METADATA.description,
            inLanguage: SITE_METADATA.language,
            publisher: { "@id": ownerId },
          },
          {
            "@type": "ImageObject",
            "@id": imageId,
            url: imageUrl.href,
            contentUrl: imageUrl.href,
            width: imageWidth,
            height: imageHeight,
            caption: image.alt,
          },
          {
            "@type": schemaType,
            "@id": pageId,
            url: canonicalUrl.href,
            name: fullTitle,
            description: metaDescription,
            inLanguage: SITE_METADATA.language,
            isPartOf: { "@id": websiteId },
            primaryImageOfPage: { "@id": imageId },
            image: { "@id": imageId },
            author,
            publisher: { "@id": ownerId },
            ...(publishedIso ? { datePublished: publishedIso } : {}),
            ...(modifiedIso ? { dateModified: modifiedIso } : {}),
          },
          ...extraStructuredData,
        ],
      }
    : undefined;
const serializedJsonLd = jsonLd
  ? JSON.stringify(jsonLd).replace(/</g, "\\u003c")
  : undefined;
const path = Astro.url.pathname;
const contributorsActive = path.includes("/authors");
---

<!doctype html>
<html
  lang={SITE_METADATA.language}
  prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#"
  data-default-theme="system"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="msvalidate.01" content="486EC2936921901A59F27BD421FB062D" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={authorName} />
    <meta name="application-name" content={SITE_METADATA.name} />
    <meta name="apple-mobile-web-app-title" content={SITE_METADATA.name} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content={SITE_METADATA.themeLight}
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content={SITE_METADATA.themeDark}
      media="(prefers-color-scheme: dark)"
    />
    <meta name="msapplication-TileColor" content={SITE_METADATA.themeDark} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}
    <link rel="home" href={siteRoot.href} />
    <link rel="author" href={SITE_METADATA.ownerUrl} />
    <link rel="me" href={SITE_METADATA.fediverseProfile} />
    <link
      rel="alternate"
      type="application/json"
      title="AI.Tedt.org library catalog"
      href={withBase("/assets.json")}
    />
    <link rel="sitemap" type="application/xml" href={withBase("/sitemap.xml")} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={(canonicalUrl ?? pageUrl).href} />
    <meta property="og:site_name" content={SITE_METADATA.name} />
    <meta property="og:locale" content={SITE_METADATA.locale} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:secure_url" content={imageUrl.href} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={image.alt} />
    {
      ogType === "article" && publishedIso && (
        <meta property="article:published_time" content={publishedIso} />
      )
    }
    {
      ogType === "article" && modifiedIso && (
        <meta property="article:modified_time" content={modifiedIso} />
      )
    }
    {
      ogType === "article" && authorUrl && (
        <meta property="article:author" content={authorUrl} />
      )
    }
    {
      ogType === "article" && section && (
        <meta property="article:section" content={section} />
      )
    }
    {
      ogType === "article" &&
        tags.map((tag) => <meta property="article:tag" content={tag} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={SITE_METADATA.twitterSite} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl.href} />
    <meta name="twitter:image:alt" content={image.alt} />
    {
      fediverseCreator && (
        <meta name="fediverse:creator" content={fediverseCreator} />
      )
    }
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="icon" type="image/png" sizes="196x196" href={withBase("/favicon-196.png")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />
    <link rel="manifest" href={withBase("/site.webmanifest")} />
    {serializedJsonLd && (
      <script type="application/ld+json" set:html={serializedJsonLd} />
    )}
    {/* Resolve the saved preference before paint to prevent a theme flash. */}
    <script
      is:inline
      set:html={`(function(){try{var d=document.documentElement;var key='ai-tedt-theme';var p=localStorage.getItem(key)||d.dataset.defaultTheme||'system';var dark=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches;var resolved=p==='system'?(dark?'dark':'light'):p;d.dataset.themePreference=p;d.setAttribute('data-theme',resolved);}catch(e){document.documentElement.dataset.themePreference='system';document.documentElement.setAttribute('data-theme','light');}})();`}
    />
    {
      ANALYTICS_ENABLED && (
        <script
          is:inline
          type="text/javascript"
          set:html={`(function(c,l,a,r,i,t,y){c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);})(window,document,"clarity","script","${CLARITY_PROJECT_ID}");`}
        />
      )
    }
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a
      href="#main-content"
      class="sr-only z-[1100] rounded bg-accent px-3 py-2 text-sm font-semibold text-accent-fg focus:not-sr-only focus:fixed focus:left-3 focus:top-3"
    >
      Skip to content
    </a>

    <UniversalHeader />

    <section class="border-b border-border bg-bg" aria-label="AI Library">
      <div
        class="mx-auto flex max-w-8xl flex-wrap items-center gap-x-5 gap-y-3 px-4 py-4 sm:px-6"
      >
        <a
          href={withBase("/")}
          class="flex shrink-0 items-center gap-3 no-underline"
          aria-label="AI.Tedt.org — AI Library"
        >
          <img
            src={withBase("/logo-site.webp")}
            alt=""
            width="38"
            height="38"
            class="h-[38px] w-[38px] rounded-sm object-cover"
          />
          <span class="flex flex-col leading-none">
            <span class="display-face text-xl text-fg">AI.Tedt.org</span>
            <span class="mt-1 text-[10px] font-semibold uppercase tracking-[0.08em] text-accent-text sm:text-xs">
              AI Library
            </span>
          </span>
        </a>

        <nav class="flex w-full flex-wrap items-center justify-between gap-3 text-sm sm:ml-auto sm:w-auto sm:justify-end sm:gap-4">
          <a
            href={FEEDBACK_URL}
            target="_blank"
            rel="noopener"
            data-clarity-event="report_issue"
            data-clarity-report-scope="site"
            class="hidden border-b-[3px] border-transparent pb-0.5 text-muted no-underline hover:border-accent-text hover:text-fg md:inline-flex"
          >
            Report an issue
          </a>
          <a
            href={withBase("/authors/")}
            class:list={[
              "hidden border-b-[3px] pb-0.5 no-underline md:inline-flex",
              contributorsActive
                ? "border-accent-text text-fg"
                : "border-transparent text-muted hover:border-accent-text hover:text-fg",
            ]}
          >
            Contributors
          </a>
          <a
            href="https://github.com/TedTschopp/cat-agent-skills/blob/main/CONTRIBUTING.md"
            target="_blank"
            rel="noopener"
            class="rounded bg-cta px-3 py-1.5 font-semibold text-cta-fg no-underline shadow-sm hover:bg-[var(--action-cta-hover)]"
          >
            <span class="sm:hidden">Contribute</span>
            <span class="hidden sm:inline">Contribute an Asset</span>
          </a>
        </nav>
      </div>
    </section>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-border bg-bg">
      <div
        class="mx-auto flex max-w-8xl flex-col gap-3 px-4 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between sm:px-6"
      >
        <p>
          A practitioner-built library of reusable files for AI agents and people.
        </p>
        <a
          href="https://github.com/TedTschopp/cat-agent-skills"
          target="_blank"
          rel="noopener"
          class="text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]"
        >
          View the Library Source
        </a>
      </div>
    </footer>

    <script
      is:inline
      set:html={`(function(){var d=document.documentElement;var key='ai-tedt-theme';var buttons=Array.prototype.slice.call(document.querySelectorAll('[data-theme-choice]'));var mq=window.matchMedia?window.matchMedia('(prefers-color-scheme: dark)'):null;function resolved(p){return p==='system'?((mq&&mq.matches)?'dark':'light'):p;}function paint(){var p=d.dataset.themePreference||'system';buttons.forEach(function(b){var on=b.dataset.themeChoice===p;b.setAttribute('aria-pressed',String(on));});}function setPreference(p,save){d.dataset.themePreference=p;d.setAttribute('data-theme',resolved(p));if(save){try{localStorage.setItem(key,p);}catch(e){}}paint();document.dispatchEvent(new CustomEvent('themechange',{detail:{theme:d.getAttribute('data-theme'),preference:p}}));}buttons.forEach(function(b){b.addEventListener('click',function(){setPreference(b.dataset.themeChoice||'system',true);});});if(mq){var onSystem=function(){if((d.dataset.themePreference||'system')==='system')setPreference('system',false);};if(mq.addEventListener)mq.addEventListener('change',onSystem);else if(mq.addListener)mq.addListener(onSystem);}paint();})();`}
    />
    {
      ANALYTICS_ENABLED && (
        <script
          is:inline
          set:html={`document.addEventListener("click",function(e){var el=e.target&&e.target.closest?e.target.closest("[data-clarity-event]"):null;if(!el||el.getAttribute("aria-disabled")==="true")return;if(typeof window.clarity!=="function")return;var name=el.getAttribute("data-clarity-event");if(!name)return;var compat=el.getAttribute("data-clarity-compat-event");for(var i=0;i<el.attributes.length;i++){var a=el.attributes[i];if(a.name.indexOf("data-clarity-")===0&&a.name!=="data-clarity-event"&&a.name!=="data-clarity-compat-event"){var key=a.name.slice("data-clarity-".length).replace(/-([a-z])/g,function(m,c){return c.toUpperCase();});window.clarity("set",key,a.value);}}window.clarity("event",name);if(compat&&compat!==name)window.clarity("event",compat);},true);`}
        />
      )
    }
  </body>
</html>
