---
import { getCollection } from "astro:content";
import AssetDetailShell from "../../components/AssetDetailShell.astro";
import SkillAssetContent from "../../components/SkillAssetContent.astro";
import { relatedAssetsFor, isSkillFamily } from "../../components/asset-detail-data";
import { getLibraryAssets, type LibraryAsset } from "../../lib/library-assets";

export async function getStaticPaths() {
  const assets = await getLibraryAssets();
  return assets
    .filter(isSkillFamily)
    .map((asset) => ({ params: { slug: asset.slug }, props: { asset } }));
}

const { asset } = Astro.props as { asset: LibraryAsset };
const [skills, guides, allAssets] = await Promise.all([
  getCollection("skills"),
  getCollection("guides"),
  getLibraryAssets(),
]);
const skill = skills.find((entry) => entry.id === asset.slug);
if (!skill) throw new Error(`Missing skill content for ${asset.slug}`);

const guide = guides.find((entry) => entry.id === asset.slug);
const relatedAssets = relatedAssetsFor(asset, allAssets);
---

<AssetDetailShell {asset} {relatedAssets} {allAssets}>
  <SkillAssetContent {asset} {skill} {guide} />
</AssetDetailShell>
