---
import Layout from "../layouts/Layout.astro";
import AssetCard from "../components/AssetCard.astro";
import {
  getLibraryAssets,
  LIBRARY_ASSET_KINDS,
  LIBRARY_ASSET_KIND_LABELS,
} from "../lib/library-assets";
import { authorKey } from "../lib/badges";
import { SITE_METADATA } from "../lib/site-metadata";
import { worksWithLabel } from "../components/asset-labels";
import { groupAssetsByTopic, topicKey } from "../components/topic-routing";

const allAssets = await getLibraryAssets();
// Publication is fail-closed. A migrated prompt can exist in the content
// collection before its required artwork is ready, but it cannot enter the
// public catalog until the normalized adapter marks it published.
const assets = allAssets.filter((asset) => asset.publicationStatus === "published");

const countValues = (values: string[][]) => {
  const counts = new Map<string, number>();
  values.flat().forEach((value) => counts.set(value, (counts.get(value) ?? 0) + 1));
  return [...counts.entries()].sort((left, right) => right[1] - left[1] || left[0].localeCompare(right[0]));
};

const kindCounts = new Map<string, number>();
for (const asset of assets) {
  kindCounts.set(asset.kind, (kindCounts.get(asset.kind) ?? 0) + 1);
}
const shownKinds = LIBRARY_ASSET_KINDS.filter((kind) => kindCounts.has(kind));
const worksWithOptions = countValues(assets.map((asset) => asset.worksWith.map(worksWithLabel)));
const topicOptions = groupAssetsByTopic(assets).map((topic) => ({
  key: topic.key,
  label: topic.label,
  count: topic.assets.length,
}));

const contributorMap = new Map<string, { name: string; count: number }>();
for (const asset of assets) {
  const key = authorKey(asset.author.github ?? undefined, asset.author.name);
  const contributor = contributorMap.get(key);
  if (contributor) contributor.count += 1;
  else contributorMap.set(key, { name: asset.author.name, count: 1 });
}
const contributors = [...contributorMap.entries()]
  .map(([key, value]) => ({ key, ...value }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name));

const librarySchema = {
  "@type": "ItemList",
  "@id": `${SITE_METADATA.url}#ai-library`,
  name: "AI Library",
  numberOfItems: assets.length,
  isPartOf: { "@id": `${SITE_METADATA.url}#webpage` },
  itemListElement: assets.map((asset, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: asset.name,
    url: new URL(asset.canonicalPath, SITE_METADATA.url).href,
  })),
};
---

<Layout
  title="AI Library"
  description={SITE_METADATA.description}
  schemaType="CollectionPage"
  structuredData={librarySchema}
>
  <section class="mx-auto max-w-8xl px-4 pb-8 pt-10 sm:px-6 sm:pb-10 sm:pt-14">
    <header>
      <span class="text-xs font-semibold uppercase tracking-[0.08em] text-accent-text">
        The Public Workbench for AI
      </span>
      <h1 class="mt-2 max-w-[18ch] text-4xl leading-tight text-[var(--text-heading)] sm:text-5xl">
        AI Library
      </h1>
      <p class="mt-3 max-w-[68ch] text-lg leading-relaxed text-muted sm:text-xl">
        Browse reusable AI assets in one catalog. Find an agent skill, agent instruction
        file, scoped agent instruction file, agent definition file, prompt template file,
        work specification file, plugin, or automation. Review how it works, then download
        the file you need.
      </p>
      <div class="accent-rule mt-5"></div>
    </header>
  </section>

  <div class="mx-auto grid max-w-8xl grid-cols-[minmax(0,1fr)] gap-8 px-4 pb-12 sm:px-6 lg:grid-cols-[17rem_minmax(0,1fr)] lg:gap-12">
    <aside class="min-w-0 rounded-lg border border-border bg-surface-2 p-4 shadow-[var(--shadow-sm)] sm:p-5" aria-label="Library filters">
      <div>
        <label for="library-search" class="text-xs font-semibold uppercase tracking-[0.08em] text-subtle">
          Search
        </label>
        <div class="mt-2 flex items-center gap-2 rounded border border-border bg-surface px-3 py-2 shadow-[var(--shadow-inset)] focus-within:border-accent">
          <input
            id="library-search"
            type="search"
            placeholder="Title, purpose, topic, or contributor…"
            autocomplete="off"
            class="min-w-0 flex-1 bg-transparent text-sm text-fg placeholder:text-subtle outline-none"
          />
          <button
            id="library-search-clear"
            type="button"
            class="text-xs text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]"
            hidden
          >
            Clear
          </button>
        </div>
      </div>

      <div class="mt-6 space-y-5 border-t border-border pt-5">
        <label for="library-kind" class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.08em] text-subtle">Asset Type</span>
          <select id="library-kind" class="library-filter-select">
            <option value="">All asset types ({assets.length})</option>
            {shownKinds.map((kind) => (
              <option value={kind}>{LIBRARY_ASSET_KIND_LABELS[kind]} ({kindCounts.get(kind)})</option>
            ))}
          </select>
        </label>

        <label for="library-works-with" class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.08em] text-subtle">Works With</span>
          <select id="library-works-with" class="library-filter-select">
            <option value="">Any provider or product</option>
            {worksWithOptions.map(([value, count]) => <option value={value}>{value} ({count})</option>)}
          </select>
        </label>

        <label for="library-topic" class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.08em] text-subtle">Topics</span>
          <select id="library-topic" class="library-filter-select">
            <option value="">All topics</option>
            {topicOptions.map((topic) => <option value={topic.key}>{topic.label} ({topic.count})</option>)}
          </select>
        </label>

        <label for="library-contributor" class="block">
          <span class="text-xs font-semibold uppercase tracking-[0.08em] text-subtle">Contributor</span>
          <select id="library-contributor" class="library-filter-select">
            <option value="">All contributors</option>
            {contributors.map((person) => <option value={person.key}>{person.name} ({person.count})</option>)}
          </select>
        </label>
      </div>

      <button
        id="library-reset"
        type="button"
        class="mt-6 text-sm font-medium text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]"
      >
        Reset Filters
      </button>
    </aside>

    <section class="min-w-0" aria-labelledby="library-results-heading">
      <div class="mb-5 flex flex-wrap items-center justify-between gap-4">
        <h2 id="library-results-heading" class="display-face text-2xl text-[var(--text-heading)]">
          Assets (<span data-library-result-count>{assets.length}</span>)
        </h2>
        <label class="flex items-center gap-2 text-sm text-muted" for="library-sort">
          <span class="text-xs font-semibold uppercase tracking-[0.08em]">Sort</span>
          <select id="library-sort" class="rounded border border-border bg-surface px-3 py-1.5 text-sm text-fg focus:border-accent focus:outline-none">
            <option value="featured">Featured</option>
            <option value="rating">Top Rated</option>
            <option value="downloads">Most Downloaded</option>
            <option value="name">Name (A–Z)</option>
            <option value="newest">Newest</option>
          </select>
        </label>
      </div>

      <div data-library-gallery class="grid grid-cols-1 gap-6 sm:grid-cols-[repeat(auto-fill,minmax(18rem,1fr))]">
        {assets.map((asset) => {
          const contributorKey = authorKey(asset.author.github ?? undefined, asset.author.name);
          const searchable = [
            asset.name,
            asset.description,
            asset.kindLabel,
            asset.author.name,
            asset.slug,
            asset.entrypoint,
            ...asset.payloadPaths,
            ...asset.topics,
            ...asset.tags,
            ...asset.keywords,
            ...asset.searchTerms,
            ...asset.compatibility,
            ...asset.worksWith,
            ...asset.worksWith.map(worksWithLabel),
          ].join(" ").toLocaleLowerCase();
          const updated = Date.parse(asset.dates.updated ?? asset.dates.created ?? "") || 0;
          return (
            <div
              data-library-item
              data-name={asset.name.toLocaleLowerCase()}
              data-search={searchable}
              data-kind={asset.kind}
              data-works-with={JSON.stringify(asset.worksWith.map(worksWithLabel))}
              data-topics={JSON.stringify([...new Set(asset.topics.map(topicKey))])}
              data-contributor={contributorKey}
              data-rating={asset.rating}
              data-downloads={asset.downloads}
              data-featured={asset.featured ? "1" : "0"}
              data-updated={updated}
            >
              <AssetCard asset={asset} />
            </div>
          );
        })}
      </div>

      <div data-library-empty class="rounded-lg border border-dashed border-border bg-surface-2 px-6 py-14 text-center" hidden>
        <h3 class="text-xl text-[var(--text-heading)]">No Matching Assets</h3>
        <p class="mt-2 text-sm text-muted">Try another search term or reset one of the filters.</p>
      </div>
      <div data-library-sentinel class="h-10" aria-hidden="true"></div>
    </section>
  </div>
</Layout>

<script>
  import "../scripts/library-catalog";
</script>
