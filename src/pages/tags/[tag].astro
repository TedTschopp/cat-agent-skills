---
import Layout from "../../layouts/Layout.astro";
import SkillCard from "../../components/SkillCard.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const skills = await getCollection("skills");
  const tags = new Set<string>();
  for (const skill of skills) for (const t of skill.data.tags) tags.add(t);

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      skills: skills
        .filter((s) => s.data.tags.includes(tag))
        .sort((a, b) => a.data.name.localeCompare(b.data.name)),
    },
  }));
}

const { tag, skills } = Astro.props;
---

<Layout
  title={`#${tag} skills`}
  description={`Copilot Studio skills tagged "${tag}".`}
>
  <div class="mx-auto max-w-8xl px-4 py-8 sm:px-6 sm:py-10">
    <a
      href={withBase("/")}
      class="inline-flex items-center gap-1.5 text-sm text-[var(--link)] underline underline-offset-2 hover:text-[var(--link-hover)]"
    >
      <span aria-hidden="true">←</span> All skills
    </a>

    <h1 class="mt-4 text-4xl leading-tight text-[var(--text-heading)] sm:text-5xl">
      <span class="text-accent-text">#</span>{tag}
    </h1>
    <p class="mt-1 text-muted">
      {skills.length}
      {skills.length === 1 ? "skill" : "skills"} tagged “{tag}”.
    </p>
    <div class="accent-rule mt-5"></div>

    <div
      class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-[repeat(auto-fill,minmax(18rem,1fr))]"
    >
      {
        skills.map((skill) => (
          <SkillCard
            slug={skill.id}
            name={skill.data.name}
            description={skill.data.description}
            platforms={skill.data.platforms}
            type={skill.data.type}
            tags={skill.data.tags}
            author={skill.data.author}
            coverColor={skill.data.coverColor}
            coverImage={skill.data.coverImage}
            coverImageAlt={skill.data.coverImageAlt}
            coverImageWidth={skill.data.coverImageWidth}
            coverImageHeight={skill.data.coverImageHeight}
            hasBundle={Boolean(skill.data.bundle)}
            isInstaller={skill.data.type === "automation" && Boolean(skill.data.bundle?.endsWith(".zip"))}
            featured={skill.data.featured}
          />
        ))
      }
    </div>
  </div>
</Layout>
