---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/url";
---

<Layout
  title="Page not found"
  description="The requested AI.Tedt.org skill or page does not exist or has moved."
  canonicalPath={false}
  noindex={true}
  fediverseCreator={false}
>
  <div
    class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center sm:px-6"
  >
    <p class="display-face text-7xl text-accent-text">404</p>
    <h1 class="mt-4 text-3xl text-[var(--text-heading)]">This page wandered off</h1>
    <p class="mt-2 text-muted">
      The skill or page you’re looking for doesn’t exist (or moved).
    </p>
    <a
      href={withBase("/")}
      class="mt-6 rounded bg-cta px-5 py-2.5 text-sm font-semibold text-cta-fg shadow-sm hover:bg-[var(--action-cta-hover)]"
      >Back to the gallery</a
    >
  </div>
</Layout>
